# 5. ZERO-TRUST AST SECURITY SHIELD
# ==================================================================================================
class ASTSecurityEngine:
    FORBIDDEN_CALLS = {"system", "popen", "spawn", "rmdir", "unlink"}
    FORBIDDEN_MODULES = {"paramiko", "telnetlib"}

    @classmethod
    def audit_code(cls, code: str) -> Tuple[bool, str]:
        try:
            tree = ast.parse(code)
            for node in ast.walk(tree):
                if isinstance(node, (ast.Import, ast.ImportFrom)):
                    mod = getattr(node, 'module', None) or ""
                    for alias in getattr(node, 'names', []):
                        if alias.name in cls.FORBIDDEN_MODULES or mod in cls.FORBIDDEN_MODULES:
                            return False, f"AST Block: Disallowed import '{alias.name or mod}'"
                elif isinstance(node, ast.Call):
                    if isinstance(node.func, ast.Attribute) and node.func.attr in cls.FORBIDDEN_CALLS:
                        return False, f"AST Block: Destructive system call '{node.func.attr}'"
            return True, "Code cleared by AST Security Shield."
        except SyntaxError as err:
            return False, f"Syntax parsing failure: {err}"

