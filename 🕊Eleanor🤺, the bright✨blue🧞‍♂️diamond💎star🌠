        attempt = 0
        prompt = f"Implement a complete, production-ready Python microservice with internal assert tests for:\n{objective}\nReturn ONLY executable Python code inside codeblocks."

        final_code = ""
        output_log = ""

        while attempt < max_repairs:
            attempt += 1
            print(f"[*] Autonomous Synthesis & Testing Loop (Pass {attempt}/{max_repairs})...")
            
            raw_response = UniversalModelRouter.query(prompt, sys_directive)
            clean_code = cls._strip_markdown(raw_response)

            # Security Inspection
            passed_ast, sec_err = ASTSecurityEngine.audit_code(clean_code)
            if not passed_ast:
                print(f"[!] AST Violation: {sec_err}")
                prompt = f"Security scan rejected your code ({sec_err}). Rewrite without dangerous calls:\n{clean_code}"
                continue

            # Ephemeral Sandbox Execution
            success, out = cls._run_sandbox(clean_code)
            if success:
                print("[✔] Code successfully converged: Passed AST and Sandbox Self-Tests!")
                final_code = clean_code
                output_log = out
                break
            else:
                print(f"[!] Sandbox Error:\n{out}")
                prompt = f"Execution failed with runtime error:\n{out}\nFix all defects and output corrected Python code:\n{clean_code}"

        return {
            "status": "CONVERGED" if final_code else "DEGRADED",
            "code": final_code,
            "output": output_log
        }

    @staticmethod
    def _strip_markdown(text: str) -> str:
        lines = text.strip().split("\n")
        if lines and lines[0].startswith("```"):
            lines = lines[1:]
        if lines and lines[-1].startswith("```"):
            lines = lines[:-1]
        return "\n".join(lines)

    @staticmethod
    def _run_sandbox(code: str) -> Tuple[bool, str]:
        tmp_name = f"_ephemeral_sandbox_{int(time.time()*1000)}.py"
        with open(tmp_name, "w", encoding="utf-8") as f:
            f.write(code)
        try:
            res = subprocess.run([sys.executable, tmp_name], capture_output=True, text=True, timeout=25)
            return (res.returncode == 0), (res.stdout.strip() if res.returncode == 0 else res.stderr.strip())
        except subprocess.TimeoutExpired:
            return False, "Sandbox Timeout: Compute exceeded threshold."
        finally:
            if os.path.exists(tmp_name):
                os.remove(tmp_name)

